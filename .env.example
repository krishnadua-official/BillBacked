# Server-only integration configuration.
# Never expose these values in client code or commit a populated environment file.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
RESEND_API_KEY=

# Twilio connection details used to configure the native ElevenLabs integration.
# The BillBacked server does not read these values directly.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFIED_DESTINATION_NUMBER=
