# Server-only integration configuration.
# Never expose these values in client code or commit a populated environment file.

# Gemini key used by services/extractor.sv.jac (Agent 1's `by llm()` calls).
GOOGLE_API_KEY=
LLM_MODEL=

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
RESEND_API_KEY=

# Twilio connection details used to configure the native ElevenLabs integration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Server-owned destination for the fictional outbound-call demo.
# A Twilio trial can call only a destination verified in the Twilio console.
TWILIO_VERIFIED_DESTINATION_NUMBER=
